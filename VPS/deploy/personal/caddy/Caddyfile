{
    # Import environment variables for Caddy to use.
    env CLOUDFLARE_API_TOKEN {$CLOUDFLARE_API_TOKEN}
    env PRIMARY_DOMAIN {$PRIMARY_DOMAIN}
    env DND_DOMAIN {$DND_DOMAIN}
    env MATRIX_DOMAIN {$MATRIX_DOMAIN}
    env DISCORD_CLIENT_ID {$DISCORD_CLIENT_ID}
    env DISCORD_CLIENT_SECRET {$DISCORD_CLIENT_SECRET}
    env DISCORD_GUILD_ID {$DISCORD_GUILD_ID}
    env CADDY_AUTH_SIGN_KEY {$CADDY_AUTH_SIGN_KEY}
    env CADDY_AUTH_VERIFY_KEY {$CADDY_AUTH_VERIFY_KEY}
    env VPN_TARGET_IP {$VPN_TARGET_IP}
}

# Global options
{
    http_port 80
    https_port 443

    order authenticate before respond
    order authorize before basicauth

    # Security block for authentication and authorization
    security {
        oauth identity provider dnd-discord {
            realm dnd-discord
            driver discord
            client_id {$DISCORD_CLIENT_ID}
            client_secret {$DISCORD_CLIENT_SECRET}
            scopes identify guilds
            user_group_filters {$DISCORD_GUILD_ID}
        }

        authentication portal dndportal {
            crypto default token lifetime 21600
            crypto key sign-verify {$CADDY_AUTH_SIGN_KEY}
            cookie domain {$DND_DOMAIN}
            enable identity provider dnd-discord

            transform user {
                match role discord.com/{$DISCORD_GUILD_ID}/members
                action add role authp/admin
            }
        }

        authorization policy dndpolicy {
            set auth url https://auth.{$DND_DOMAIN}/
            crypto key verify {$CADDY_AUTH_VERIFY_KEY}
            allow roles authp/admin authp/user
            validate bearer header
            inject headers with claims
        }
    }
}

# Reusable snippets (no changes needed here)
(tls_cloudflare) {
    tls {
        dns cloudflare {$CLOUDFLARE_API_TOKEN}
    }
}

(cors) {
    @origin header Origin {args.0}
    header @origin {
        Access-Control-Allow-Origin "{args.0}"
        Access-Control-Request-Method GET
        Access-Control-Allow-Headers *
        defer
    }
}

# Site Definitions
auth.{$DND_DOMAIN} {
    import tls_cloudflare
    authenticate with dndportal
}

{$DND_DOMAIN} {
    import tls_cloudflare
    authorize with dndpolicy
    reverse_proxy vtt:30000
}

https://nextcloud.{$PRIMARY_DOMAIN}:443 {
    import tls_cloudflare
    reverse_proxy http://nextcloud-aio-mastercontainer:11000 {
         # The AIO docs recommend these headers
         header_up Host {host}
         header_up X-Real-IP {remote_ip}
         header_up X-Forwarded-For {remote_ip}
         header_up X-Forwarded-Proto {scheme}
    }
}

http://nextcloud.{$PRIMARY_DOMAIN}:80 {
    # Redirect to HTTPS
    redir https://nextcloud.{$PRIMARY_DOMAIN}{uri} permanent
}

vpn.{$PRIMARY_DOMAIN}:51820 {
    import tls_cloudflare
    reverse_proxy {$VPN_TARGET_IP}:51820
}

silly.{$PRIMARY_DOMAIN} {
    import tls_cloudflare
    reverse_proxy invidious:3000
}

{$MATRIX_DOMAIN} {
    import tls_cloudflare
    
    handle /.well-known/matrix/server {
        respond `{"m.server": "{$MATRIX_DOMAIN}:443"}` 200
        header Content-Type "application/json; charset=utf-8"
    }
    
    handle /.well-known/matrix/client {
        respond `{"m.homeserver": {"base_url": "https://{$MATRIX_DOMAIN}"}, "org.matrix.msc4143.rtc_foci":[{"type":"livekit","livekit_service_url":"https://livekit.{$MATRIX_DOMAIN}"}]}` 200
        header Content-Type "application/json; charset=utf-8"
        header Access-Control-Allow-Origin "*"
    }
    
    reverse_proxy /_matrix/* homeserver:6167 {
        header_up Host {host}
        header_up X-Real-IP {remote_ip}
        header_up X-Forwarded-For {remote_ip}
        transport http {
            read_timeout 60s
        }
    }

    handle {
        abort
    }
}

element.{$MATRIX_DOMAIN} {
    import tls_cloudflare
    reverse_proxy element:3030
}

cinny.{$MATRIX_DOMAIN} {
    import tls_cloudflare
    reverse_proxy cinny:80
}

elementcall.{$MATRIX_DOMAIN} {
    import tls_cloudflare
    reverse_proxy element-call:8080
}

livekit.{$MATRIX_DOMAIN} {
    import tls_cloudflare

    handle /livekit/jwt* {
        reverse_proxy http://livekit-jwt:8080
    }

    handle /livekit/sfu* {
        uri strip_prefix /livekit/sfu
        reverse_proxy livekit:7880
    }

    handle /sfu/get* {
         reverse_proxy http://livekit-jwt:8080
    }

    handle {
        abort
    }
}

gitea.{$PRIMARY_DOMAIN} {
    import tls_cloudflare
    reverse_proxy gitea:3000
}
