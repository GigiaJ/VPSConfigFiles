# General
PUID=1000
PGID=1000
TZ=Etc/UTC
DEPLOY_PATH=/deploy

# Docker Network Subnets
PERSONAL_IPAM_SUBNET=172.20.0.0
NEXTCLOUD_IPAM_SUBNET=172.21.0.0

# Wireguard
WIREGUARD_SERVERURL=your.domain.com
WIREGUARD_SERVERPORT=51820
WIREGUARD_PEERS=1
WIREGUARD_PEERDNS=172.20.0.2 # This should point to your unbound container's IP
WIREGUARD_INTERNAL_SUBNET=10.13.13.0
WIREGUARD_ALLOWEDIPS=0.0.0.0/0

# Nextcloud
NEXTCLOUD_PORT=8080
NEXTCLOUD_APACHE_PORT=11000
NEXTCLOUD_IPV4=172.20.0.3

# Redbot
REDBOT_NAME=MyBot

# Foundry VTT
FOUNDRY_USERNAME=your_foundry_username
FOUNDRY_PASSWORD=your_foundry_password

# Matrix Homeserver (Conduit)
MATRIX_SERVER_NAME=your.matrix.domain.com
MATRIX_ALLOW_REGISTRATION=true
MATRIX_REGISTRATION_TOKEN=YourSecretRegistrationTokenHere

# LiveKit
LIVEKIT_SECRET=A_Very_Secret_Key_For_LiveKit
LIVEKIT_KEY=YourLiveKitKey
LIVEKIT_URL=livekit.your.domain.com

# Gitea
GITEA_PORT=3000
GITEA_SSH_PORT=10022

# Postgres (for mautrix-discord, etc.)
# Note: The 'database' service uses env_file, so these go directly into your .env
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=a_strong_password
