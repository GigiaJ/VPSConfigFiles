# --- GENERAL ---
PUID=1000
PGID=1000
TZ=Etc/UTC
DEPLOY_PATH=/deploy

# --- DOMAINS ---
PRIMARY_DOMAIN=something.org
DND_DOMAIN=dnd.something.org
MATRIX_DOMAIN=matrix.org

# --- DOCKER NETWORKING ---
PERSONAL_IPAM_SUBNET=172.20.0.0
# NEXTCLOUD_IPAM_SUBNET is managed by AIO, not needed here

# --- CADDY ---
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CADDY_AUTH_SIGN_KEY=generate_a_long_random_string_for_signing
CADDY_AUTH_VERIFY_KEY=generate_another_long_random_string_for_verifying
VPN_TARGET_IP=192.168.1.7 # Internal IP of your VPN host if not running on the same docker host

# --- CADDY OAUTH (DISCORD) ---
DISCORD_CLIENT_ID=your_discord_app_client_id
DISCORD_CLIENT_SECRET=your_discord_app_client_secret
DISCORD_GUILD_ID=your_discord_server_id_for_role_checks

# --- WIREGUARD ---
WIREGUARD_SERVERURL=vpn.something.org
WIREGUARD_SERVERPORT=51820
WIREGUARD_PEERS=1
WIREGUARD_PEERDNS=172.20.0.2 # IP of the 'unbound' container
WIREGUARD_INTERNAL_SUBNET=10.13.13.0
WIREGUARD_ALLOWEDIPS=0.0.0.0/0

# --- NEXTCLOUD ---
NEXTCLOUD_PORT=8080
NEXTCLOUD_APACHE_PORT=11000
NEXTCLOUD_IPV4=172.20.0.3

# --- REDBOT ---
REDBOT_NAME=MyBot

# --- FOUNDRY VTT ---
FOUNDRY_USERNAME=your_foundry_username
FOUNDRY_PASSWORD=your_foundry_password

# --- MATRIX HOMESERVER (CONDUIT) ---
# MATRIX_SERVER_NAME is derived from MATRIX_DOMAIN
MATRIX_ALLOW_REGISTRATION=true
MATRIX_REGISTRATION_TOKEN=YourSecretRegistrationTokenHere

# --- LIVEKIT ---
LIVEKIT_SECRET=A_Very_Secret_Key_For_LiveKit
LIVEKIT_KEY=YourLiveKitKey
# LIVEKIT_URL is derived from MATRIX_DOMAIN

# --- GITEA ---
GITEA_PORT=3000
GITEA_SSH_PORT=10022

# --- POSTGRES (for mautrix-discord, etc.) ---
# The 'database' service uses env_file, so these go directly into your .env
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=a_strong_password
